---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CONTACT // PRAMAY USADADIYA" activeNav="CONTACT">
  <main id="main-content" class="contact-page">
    <div class="contact-container">
      <div class="contact-header">
        <span class="contact-tag">04 // COMMUNICATIONS</span>
        <h1 class="contact-title">LET'S BUILD SOMETHING DIFFICULT.</h1>
        <p class="contact-sub">
          Available for senior AI engineering roles, technical architecture consulting, and agentic RAG systems implementation.
        </p>
      </div>

      <div class="contact-links-grid">
        <a href="mailto:upramay@gmail.com" class="contact-card brutalist-box">
          <span class="contact-label">EMAIL DIRECT</span>
          <span class="contact-val">upramay@gmail.com</span>
          <span class="contact-arrow">&rarr; SEND MESSAGE</span>
        </a>

        <!-- <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="contact-card brutalist-box">
          <span class="contact-label">GITHUB REPOSITORIES</span>
          <span class="contact-val">github.com/pramay</span>
          <span class="contact-arrow">&rarr; VIEW CODE</span>
        </a> -->

        <a href="https://www.linkedin.com/in/pramay-usdadiya/" target="_blank" rel="noopener noreferrer" class="contact-card brutalist-box">
          <span class="contact-label">LINKEDIN PROFILE</span>
          <span class="contact-val">linkedin.com</span>
          <span class="contact-arrow">&rarr; CONNECT</span>
        </a>

        <a href="https://drive.google.com/file/d/1CIrkV9DiyAQfB5QxsbuoZoJpSU2NUmkl/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="contact-card brutalist-box brutalist-box-accent">
          <span class="contact-label">ENGINEERING DOSSIER</span>
          <span class="contact-val">RESUME.PDF</span>
          <span class="contact-arrow">&rarr; VIEW PDF</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page {
    min-height: 85vh;
    padding: var(--space-32) var(--space-6) var(--space-16);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-container {
    max-width: 900px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .contact-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .contact-sub {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .contact-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .contact-val {
    font-family: var(--font-sans);
    font-size: var(--font-size-xl);
    font-weight: 700;
  }

  .contact-arrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
    margin-top: var(--space-4);
  }
</style>
