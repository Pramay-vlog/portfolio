---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonicalURL?: string;
  type?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Pramay Usadadiya — AI Software Engineer',
  description = 'Portfolio of Pramay Usadadiya — AI Software Engineer building reasoning agents, grounded RAG systems, and production backends.',
  image = '/og.png',
  imageAlt = 'Pramay Usadadiya — AI Software Engineer Portfolio',
  imageWidth = 1200,
  imageHeight = 630,
  canonicalURL = Astro.url.href,
  type = 'website',
  jsonLd,
} = Astro.props;

const siteName = 'Pramay Usadadiya';
// Only append site name if the title doesn't already contain it
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const fullImageURL = new URL(image, Astro.site || Astro.url.origin).href;

const imageExt = image.split('?')[0].split('.').pop()?.toLowerCase();
const imageType =
  imageExt === 'png'
    ? 'image/png'
    : imageExt === 'jpg' || imageExt === 'jpeg'
    ? 'image/jpeg'
    : imageExt === 'webp'
    ? 'image/webp'
    : imageExt === 'gif'
    ? 'image/gif'
    : undefined;

// Default JSON-LD for the site (Person schema)
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pramay Usadadiya',
  url: Astro.site?.href ?? Astro.url.origin,
  jobTitle: 'AI Software Engineer',
  description,
  image: fullImageURL,
  sameAs: [
    'https://github.com/upramay',
  ],
};

const structuredData = jsonLd ?? defaultJsonLd;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp / iMessage -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:image:secure_url" content={fullImageURL} />
{imageType && <meta property="og:image:type" content={imageType} />}
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
