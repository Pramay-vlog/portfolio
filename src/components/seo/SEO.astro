---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
}

const {
  title = 'Pramay Usadadiya — AI Software Engineer',
  description = 'Pramay Usadadiya — AI Software Engineer, System Builder, and Researcher. Portfolio featuring grounded RAG architectures, agentic reasoning, and system post-mortems.',
  image = '/og-preview.svg',
  canonicalURL = Astro.url.href,
  type = 'website',
} = Astro.props;

const siteName = 'Pramay Usadadiya — AI Software Engineer';
const fullTitle = title.includes('Pramay Usadadiya') ? title : `${title} | ${siteName}`;
const fullImageURL = new URL(image, Astro.site || Astro.url.origin).href;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageURL} />
