---
interface Props {
  title: string;
  classification: string;
  level: string;
  status: string;
  missionId: string;
}

const { title, classification, level, status, missionId } = Astro.props;
---

<header class="dossier-header brutalist-box-accent">
  <div class="header-meta-row">
    <span class="brutalist-badge">MISSION DOSSIER // DECLASSIFIED</span>
    <span class="dossier-level">{level}</span>
  </div>
  <h1 class="dossier-title">{title}</h1>
  <div class="classification-tag">{classification}</div>
  <div class="dossier-status-bar">
    <span>STATUS: <strong>{status}</strong></span>
    <span class="dossier-id-tag">ID: {missionId.toUpperCase()}</span>
  </div>
</header>

<style>
  .dossier-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .header-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .dossier-level {
    color: var(--color-text-muted);
  }

  .dossier-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-3xl);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .classification-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
    background-color: var(--color-accent-dim);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-accent-primary);
    display: inline-block;
    width: fit-content;
  }

  .dossier-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-2);
  }

  .dossier-id-tag {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .dossier-title {
      font-size: clamp(1.5rem, 6vw, 2.2rem);
    }

    .header-meta-row,
    .dossier-status-bar {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>
