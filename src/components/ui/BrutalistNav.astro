---
interface Props {
  activeNav?: string;
}

const { activeNav = '' } = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'WORK', href: '/work' },
  { label: 'LAB', href: '/lab' },
  { label: 'ABOUT', href: '/about' },
  { label: 'CONTACT', href: '/contact' },
];
---

<header class="brutalist-nav-header">
  <div class="nav-container">
    <!-- Brand Identity -->
    <a href="/" class="nav-brand" aria-label="PRAMAY Home">
      <span class="brand-name">PRAMAY</span><span class="brand-dot">.</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links-desktop" aria-label="Primary Navigation">
      {
        navItems.map((item) => {
          const isActive =
            activeNav.toUpperCase() === item.label ||
            currentPath === item.href ||
            (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`nav-item-link ${isActive ? 'is-active' : ''}`}
            >
              {item.label}
              {isActive && <span class="active-indicator" />}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      id="mobile-nav-toggle"
      class="mobile-nav-btn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true">
    <nav class="mobile-nav-links">
      {
        navItems.map((item) => {
          const isActive =
            activeNav.toUpperCase() === item.label ||
            currentPath === item.href ||
            (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}
            >
              <span class="mobile-nav-num">0{navItems.indexOf(item) + 1}</span>
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const overlay = document.getElementById('mobile-nav-overlay');

    if (!toggleBtn || !overlay) return;

    // Prevent duplicate click listener registration across Astro lifecycle hooks
    if ((toggleBtn as any)._navSetupDone) return;
    (toggleBtn as any)._navSetupDone = true;

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isOpen;

      toggleBtn.setAttribute('aria-expanded', String(newState));
      toggleBtn.classList.toggle('is-open', newState);
      overlay.classList.toggle('is-open', newState);
      overlay.setAttribute('aria-hidden', String(!newState));

      if (newState) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    const mobileLinks = overlay.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('is-open');
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupMobileNav();
  }
  document.addEventListener('DOMContentLoaded', setupMobileNav);
  document.addEventListener('astro:page-load', setupMobileNav);
</script>

<style>
  .brutalist-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 72px;
    background-color: rgba(251, 249, 245, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color-subtle);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .nav-container {
    max-width: var(--max-width-site);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: var(--font-size-xl);
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand-dot {
    color: var(--color-accent-primary);
    font-weight: 900;
  }

  .nav-links-desktop {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-item-link {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color 0.2s ease;
  }

  .nav-item-link:hover {
    color: var(--color-text-primary);
  }

  .nav-item-link.is-active {
    color: var(--color-accent-primary);
  }

  .active-indicator {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent-primary);
  }

  /* Mobile Toggle Button */
  .mobile-nav-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    padding: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10001;
  }

  .menu-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-nav-btn.is-open .menu-bar:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }

  .mobile-nav-btn.is-open .menu-bar:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile Overlay */
  .mobile-nav-overlay {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100vh - 72px);
    background-color: var(--color-bg-primary);
    display: flex;
    flex-direction: column;
    padding: var(--space-8) var(--space-6);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 10000;
    overflow-y: auto;
  }

  .mobile-nav-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mobile-nav-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--border-color-subtle);
    padding-bottom: var(--space-4);
  }

  .mobile-nav-num {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-accent-primary);
  }

  .mobile-nav-link.is-active {
    color: var(--color-accent-primary);
  }

  @media (max-width: 768px) {
    .nav-links-desktop {
      display: none;
    }

    .mobile-nav-btn {
      display: flex;
    }
  }
</style>
