<footer class="global-footer">
  <div class="footer-inner">
    <!-- Statement Row -->
    <div class="footer-statement-row">
      <div class="statement-title">BUILD SYSTEMS THAT THINK.</div>
      <p class="statement-sub">
        AI Software Engineer specializing in intelligent multi-agent orchestrations, grounded RAG architectures, and production backend systems.
      </p>
    </div>

    <!-- Quick Links Grid -->
    <div class="footer-links-grid">
      <div class="link-col">
        <span class="col-title">// NAVIGATION</span>
        <a href="/work" class="footer-link">WORK &amp; MISSIONS</a>
        <a href="/lab" class="footer-link">AI LABORATORY</a>
        <a href="/about" class="footer-link">ABOUT &amp; EXPERIENCE</a>
        <a href="/contact" class="footer-link highlight">GET IN TOUCH &rarr;</a>
      </div>

      <div class="link-col">
        <span class="col-title">// ARCHIVES</span>
        <a href="/failures" class="footer-link">FAILURES ARCHIVE</a>
        <a href="/sitemap.xml" class="footer-link">SYSTEM INDEX (XML)</a>
      </div>

      <div class="link-col">
        <span class="col-title">// CONNECT</span>
        <a href="mailto:upramay@gmail.com" class="footer-link" target="_blank" rel="noopener noreferrer">Email</a>
        <a href="https://linkedin.com" class="footer-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com" class="footer-link" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>

    <!-- System Meta Footer Line -->
    <div class="footer-meta-bar">
      <div class="meta-item">PRAMAY USADADIYA &copy; {new Date().getFullYear()}</div>
      <div class="meta-item text-center">LOC: 23.0225&deg; N, 72.5714&deg; E</div>
      <div class="meta-item text-right">STATUS: PRODUCTION_READY</div>
    </div>
  </div>
</footer>

<style>
  .global-footer {
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--border-color-subtle);
    padding: var(--space-16) var(--space-6) var(--space-8);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-width-site);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .footer-statement-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .statement-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .statement-sub {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.5;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-8);
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-8);
  }

  .link-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }

  .footer-link.highlight {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .footer-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color-subtle);
    padding-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .meta-item {
    flex: 1;
  }

  .text-center {
    text-align: center;
  }

  .text-right {
    text-align: right;
  }

  @media (max-width: 768px) {
    .statement-title {
      font-size: var(--font-size-2xl);
    }

    .footer-meta-bar {
      flex-direction: column;
      gap: var(--space-2);
      text-align: left;
    }

    .text-center, .text-right {
      text-align: left;
    }
  }
</style>
